import tkinter as tk
from tkinter import messagebox

# Функция, которая сработает при нажатии на кнопку
def run_round_robin():
    # Получаем текст из полей ввода
    processes_text = entry_processes.get()
    burst_text = entry_burst.get()
    quantum_text = entry_quantum.get()
    
    # Простейшая проверка на пустоту
    if not processes_text or not burst_text or not quantum_text:
        messagebox.showerror("Ошибка", "Пожалуйста, заполните все поля!")
        return

    try:
        # Превращаем текст в списки и числа (как в Python!)
        processes = [p.strip() for p in processes_text.split(",")]
        burst_times = [int(b.strip()) for b in burst_text.split(",")]
        quantum = int(quantum_text.strip())
        
        # Здесь будет твоя логика Round Robin (пока выведем результат в консоль или на экран)
        result_text = f"Процессы: {processes}\nВремя: {burst_times}\nКвант: {quantum}\n\n[Алгоритм выполнен успешно!]"
        
        # Показываем результат пользователю
        label_result.config(text=result_text, fg="#4CAF50")
        
    except ValueError:
        messagebox.showerror("Ошибка", "Проверь правильность ввода! Время и квант должны быть числами, а процессы через запятую.")

# Создаем главное окно приложения
root = tk.Tk()
root.title("Round Robin UI")
root.geometry("350x400")
root.configure(bg="#2d2d2d")

# Заголовок
title_label = tk.Label(root, text="Round Robin", font=("Arial", 16, "bold"), bg="#2d2d2d", fg="#4CAF50")
title_label.pack(pady=20)

# Поле 1: Процессы
tk.Label(root, text="Список процессов (через запятую):", bg="#2d2d2d", fg="white").pack(anchor="w", padx=30)
entry_processes = tk.Entry(root, width=30, bg="#3c3c3c", fg="white", insertbackground="white")
entry_processes.pack(pady=5, padx=30)
entry_processes.insert(0, "P1, P2, P3")

# Поле 2: Время выполнения
tk.Label(root, text="Время выполнения (Burst Time):", bg="#2d2d2d", fg="white").pack(anchor="w", padx=30)
entry_burst = tk.Entry(root, width=30, bg="#3c3c3c", fg="white", insertbackground="white")
entry_burst.pack(pady=5, padx=30)
entry_burst.insert(0, "10, 5, 8")

# Поле 3: Квант
tk.Label(root, text="Квант времени (Quantum):", bg="#2d2d2d", fg="white").pack(anchor="w", padx=30)
entry_quantum = tk.Entry(root, width=30, bg="#3c3c3c", fg="white", insertbackground="white")
entry_quantum.pack(pady=5, padx=30)
entry_quantum.insert(0, "3")

# Кнопка запуска
btn = tk.Button(root, text="Запустить расчет", bg="#4CAF50", fg="white", font=("Arial", 11, "bold"), command=run_round_robin)
btn.pack(pady=20, padx=30, fill="x")

# Метка для вывода результата
label_result = tk.Label(root, text="", bg="#2d2d2d", fg="white", justify="left")
label_result.pack(pady=10)

# Запускаем приложение
root.mainloop()
                       
